# Copia este archivo como .env (no se versiona) y cambia los valores.

# --- Base de datos (PostgreSQL + pgvector) ---
DB_PASSWORD=cambia-esta-clave-larga
# Alternativa: una URL completa, p. ej. para correr la API fuera de Docker:
# DATABASE_URL=postgresql://barber:barber@localhost:5432/barber

# --- Seguridad ---
JWT_SECRET=cambia-este-secreto-de-32-caracteres-o-mas
# Orígenes permitidos por CORS, separados por comas (vacío: el frontend va detrás de nginx en el mismo dominio)
CORS_ORIGINS=

# --- Administrador inicial (opcional) ---
# Si se definen, el administrador se crea al arrancar. Si no, la primera cuenta registrada queda como administrador.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- IA local (Ollama) ---
LLM_MODEL=llama3

# --- Correo y enlaces ---
PUBLIC_URL=http://localhost:8080
MAILHOG_URL=http://localhost:8025

# --- Barbería ---
BARBERIA_NOMBRE=BarberForge Popayán
ZONA_HORARIA=America/Bogota
SEED_DEMO=true
